{
  "name": "medbook",
  "version": "1.0.0",
  "description": "Doctor appointment booking platform (MERN) - rebuilt from reference repo",
  "main": "server.js",
  "scripts": {
    "setup": "npm install && npm install --prefix client",
    "db": "node scripts/dev-db.js",
    "seed": "node seed-demo.js",
